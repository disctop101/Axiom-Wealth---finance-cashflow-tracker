# ========================================================
# Axiom Wealth - Environment Configuration Template
# Duplicate this file as .env or .env.local
# ========================================================

# Gemini AI API Configuration (Optional / AI Studio Applet runtime)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Application URL
APP_URL="http://localhost:3000"

# RevenueCat Web Billing Public Key
VITE_REVENUECAT_PUBLIC_KEY="appl_your_revenuecat_public_key"

# Firebase Client Configuration (if not using firebase-applet-config.json)
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
